# PostgreSQL
POSTGRES_DB=guacamole_db
POSTGRES_USER=guacamole_user
POSTGRES_PASSWORD=guacamole_pass

# Guacamole
GUACD_HOSTNAME=guacd
POSTGRESQL_HOSTNAME=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=guacamole_db
POSTGRESQL_USER=guacamole_user
POSTGRESQL_PASSWORD=guacamole_pass

# Guacamole JSON auth — shared key between the Viewport backend and Guacamole.
# Generate your own for any non-local deployment: openssl rand -hex 16
JSON_SECRET_KEY=55fe9a4aa6bc6d17a111ec5a1b83da66

# Password for the optional "ubuntu-desktop" demo connection (real machine)
UBUNTU_RDP_PASSWORD=changeme

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_ROOT_URL=http://localhost/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS=sparkanswers-viewport-app,sparkanswers-viewport-panel
