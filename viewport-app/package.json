{
  "name": "viewport-app",
  "version": "2.1.0",
  "description": "Grafana app plugin for secure remote desktop access via Apache Guacamole",
  "scripts": {
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "webpack -c .config/webpack/webpack.config.ts --env production",
    "build:backend": "bash build-backend.sh",
    "build:backend:local": "cd pkg && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o ../dist/gpx_viewport_linux_amd64 . && chmod 755 ../dist/gpx_viewport_linux_amd64",
    "dev": "webpack -w -c .config/webpack/webpack.config.ts --env development",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "jest --passWithNoTests",
    "test:backend": "cd pkg && go test ./...",
    "lint": "eslint --fix src/",
    "typecheck": "tsc --noEmit"
  },
  "author": "Viewport",
  "license": "Apache-2.0",
  "devDependencies": {
    "@swc/core": "^1.3.90",
    "@swc/jest": "^0.2.29",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.5",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.10",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.3",
    "style-loader": "^4.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "swc-loader": "^0.2.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@grafana/data": "^12.3.3",
    "@grafana/runtime": "^12.3.3",
    "@grafana/ui": "^12.3.3",
    "guacamole-common-js": "^1.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tslib": "^2.6.2"
  },
  "peerDependencies": {
    "@grafana/data": ">=10.0.0",
    "@grafana/runtime": ">=10.0.0",
    "@grafana/ui": ">=10.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
